# =========================================================================
# WHITE-LABEL ENTERPRISE AIOS & N8N VPS CONFIGURATION
# Copy to .env OR run: python3 scripts/setup_wizard.py
# =========================================================================

# --- [1] White-Label Brand & Pricing Customization ---
BRAND_NAME=YourBrandAIOS
MENTORS_LIST=Lead Strategist,Mentor Alpha,Mentor Beta,Mentor Gamma,Mentor Delta
SUPPORTED_PLATFORMS=Webull,Interactive Brokers (IBKR),TradingView
LIVE_SESSION_SCHEDULE=Mon-Fri 21:30 Local Time
VIP_MONTHLY_USD=45
WORKSHOP_MEMBER_PRICE=4000
WORKSHOP_NONMEMBER_PRICE=6000
PRIVATE_SESSION_USD=100
WORKSHOP_MAX_SEATS=20
TZ=Africa/Cairo

# --- [2] VPS Domain & n8n Workflow Engine ---
N8N_HOST=0.0.0.0
N8N_PORT=5678
N8N_PROTOCOL=https
# Public HTTPS URL of your client VPS n8n (required for live Telegram webhooks):
WEBHOOK_URL=https://n8n.yourdomain.com/
# Optional n8n API key (from n8n Settings -> n8n API) for automated API workflow sync/publish:
N8N_API_KEY=
N8N_ENCRYPTION_KEY=REPLACE_WITH_32_CHAR_HEX_KEY
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
NODE_FUNCTION_ALLOW_EXTERNAL=mongodb,nodemailer,axios

# --- [3] Security & Executive Authorization (Auto-generated by 1-Click Wizard) ---
TRADESAJON_BRIDGE_SECRET=REPLACE_WITH_RANDOM_BRIDGE_SECRET
WORKSHOP_LAUNCH_TOKEN=REPLACE_WITH_RANDOM_WORKSHOP_TOKEN
AIOS_INTERNAL_TOKEN=REPLACE_WITH_RANDOM_AIOS_TOKEN
# Comma-separated numeric Telegram IDs of authorized executives:
CEO_USER_IDS=
CEO_CHAT_ID=

# --- [4] AI Reasoning & Voice Synthesis ---
# Primary fast LLM reasoning & Whisper STT:
GROQ_API_KEY=
# Optional secondary multimodal & voice models:
GEMINI_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pFZP5JQG7iQjIQuC4Bku

# --- [5] Telegram Bots (@BotFather) ---
TELEGRAM_CEO_BOT_TOKEN=
TELEGRAM_PR_BOT_TOKEN=
TELEGRAM_TRADER_BOT_TOKEN=
TELEGRAM_VIP_CHANNEL_ID=

# --- [6] Discord Bots & Community Server ---
# Provide a shared DISCORD_BOT_TOKEN OR separate per-persona tokens below:
DISCORD_BOT_TOKEN=
DISCORD_CEO_BOT_TOKEN=
DISCORD_PR_BOT_TOKEN=
DISCORD_TRADER_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
DISCORD_GUILD_ID=
DISCORD_ANNOUNCEMENT_CHANNEL_ID=
DISCORD_LIVE_VOICE_CHANNEL_ID=
DISCORD_ACTIVE_MEMBER_ROLE_ID=
DISCORD_CEO_USER_IDS=
DISCORD_PR_ROLE_IDS=

# --- [7] Database (Auto-configured local Docker MongoDB OR external MongoDB Atlas URI) ---
MONGODB_URI=mongodb://mongodb:27017/tradesejon_prod
MONGODB_DB=tradesejon_prod

# --- [8] Payment Gateway (Whop — Optional) ---
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=
WHOP_CHECKOUT_URL=https://whop.com/checkout/YOUR_PLAN_ID

# --- [9] Transactional Email (Resend OR Gmail SMTP — Optional) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=vip@yourdomain.com
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- [10] Master Ledger Sync (Google Sheets — Optional) ---
TRADESAJON_GSHEET_ID=
TRADESAJON_GSHEETS_WEBHOOK_URL=
